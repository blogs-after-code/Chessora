# Copy to .env and fill in. Never commit the real .env.
APP_ENV=development
PORT=3000
# Local development uses a SQLite file in src/app/data/ automatically.
# For a hosted Turso database (production), set both:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=
# Set to 1 when running behind a host's proxy (Render etc.):
# TRUST_PROXY=1
# Set APP_ENV=production online so cookies are marked Secure.
